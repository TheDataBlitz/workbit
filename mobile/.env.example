# Copy to .env in this folder (keep this file under mobile/).
# Either pair works; Babel inlines them at bundle time:
#   SUPABASE_URL / SUPABASE_ANON_KEY
#   VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY (same values as the web app)
#
# REST API (workspaces list, etc.). Use a host the device/emulator can reach:
#   http://10.0.2.2:3001 — Android emulator → host machine localhost
#   http://<your-lan-ip>:3001 — physical device on the same Wi‑Fi (e.g. http://192.168.31.167:3001)

VITE_API_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
